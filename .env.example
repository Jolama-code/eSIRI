# --- OpenAI (agent, briefing parser, speech) ---
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TTS_MODEL=gpt-4o-mini-tts
OPENAI_TTS_VOICE=coral
TTS_PROVIDER=openai              # openai | chatterbox (stub, not implemented)
ESIRI_ENGLISH_TTS=openai         # openai | browser

# --- NURU v2 ---
NURU_TZ=Africa/Dar_es_Salaam
MINUTES_RECIPIENTS=you@example.com   # comma-separated; where approved minutes are e-mailed
# NURU_DB=backend/data/nuru.db        # optional override of the SQLite file
# NURU_TEST_MODE=1                    # set by Playwright: Katibu e-mails go only to KATIBU_TEST_RECIPIENT

# --- KatibuAI (running separately, default port 8000) ---
KATIBU_BASE_URL=http://localhost:8000
KATIBU_CLIENT_ID=katibuai-android
KATIBU_USERNAME=your-katibu-user@example.com
KATIBU_PASSWORD=change-me
KATIBU_TEST_RECIPIENT=you+testing@example.com
